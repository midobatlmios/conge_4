# Production settings for Laravel Cloud (see DEPLOY.md).
# Paste these into the environment's "Custom environment variables" in the
# Cloud dashboard. Do not commit real secrets.
#
# Set automatically by Laravel Cloud, so leave them out:
#   APP_KEY, DB_*, the database connection, and the "uploads" bucket credentials
#   (attach the bucket with the disk name "uploads").

APP_NAME="Gestion des Congés"
APP_ENV=production
APP_DEBUG=false
APP_URL=https://conge.example.ma

APP_LOCALE=fr
APP_FALLBACK_LOCALE=en
APP_FAKER_LOCALE=fr_FR

LOG_CHANNEL=stderr
LOG_LEVEL=warning

SESSION_DRIVER=database
SESSION_LIFETIME=120
SESSION_ENCRYPT=true
SESSION_SECURE_COOKIE=true

CACHE_STORE=database
QUEUE_CONNECTION=sync
FILESYSTEM_DISK=local

# Brevo SMTP (sender address must be verified in Brevo).
MAIL_MAILER=smtp
MAIL_HOST=smtp-relay.brevo.com
MAIL_PORT=587
MAIL_USERNAME=
MAIL_PASSWORD=
MAIL_FROM_ADDRESS="rh@example.ma"
MAIL_FROM_NAME="${APP_NAME}"

# Error monitoring. Empty = Sentry stays off.
SENTRY_LARAVEL_DSN=
SENTRY_ENVIRONMENT=production
SENTRY_TRACES_SAMPLE_RATE=0
# Never send names, e-mails or IP addresses of employees to Sentry.
SENTRY_SEND_DEFAULT_PII=false

VITE_APP_NAME="${APP_NAME}"
