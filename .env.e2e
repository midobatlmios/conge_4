# Environment for the end-to-end tests (Playwright, `npm run test:e2e`).
# Loaded with `--env=e2e`. Uses its own SQLite file, wiped before every run,
# so the real database is never touched. The key below is for tests only.
APP_NAME="Gestion des Congés"
APP_ENV=e2e
APP_KEY=base64:FIUz/5HXCTwSctvBZNLAEMhc+c5bEyOqNm+lWNcbMh4=
APP_DEBUG=true
APP_URL=http://127.0.0.1:8001
APP_LOCALE=fr
APP_FALLBACK_LOCALE=fr
APP_FAKER_LOCALE=fr_FR

BCRYPT_ROUNDS=4

LOG_CHANNEL=single
LOG_LEVEL=debug

DB_CONNECTION=sqlite
DB_DATABASE=database/e2e.sqlite

SESSION_DRIVER=file
CACHE_STORE=array
QUEUE_CONNECTION=sync
FILESYSTEM_DISK=local

# Emails are written to storage/logs/laravel.log instead of being sent.
MAIL_MAILER=log
MAIL_FROM_ADDRESS="conges@example.com"
MAIL_FROM_NAME="${APP_NAME}"
